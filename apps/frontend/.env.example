# PostgreSQL database connection string
DATABASE_URL="postgres://matrix_user:crypto@192.168.1.28:5432/rsimatrix?sslmode=disable"

# NextAuth.js configuration
# The canonical URL of your production site
NEXTAUTH_URL="http://localhost:3000" # Dev value
# A secret to sign tokens, generate it with `openssl rand -base64 32`
NEXTAUTH_SECRET="yoursupersecretkey"

# Google OAuth credentials for NextAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Comma-separated list of emails allowed to sign in to the admin panel
ALLOWED_EMAILS="user1@example.com,user2@example.com"

# Discord webhook for plain notifications (newsletter signups, contact form
# messages) — a simple POST, no bot involved.
DISCORD_WEBHOOK_URL=""

# Discord BOT for new leads specifically (src/server/discord-bot.ts). Unlike
# the webhook above, this is a real bot identity that stays connected so it
# can read the 🔵/✅/❌ reactions people add to a lead message and update the
# lead's status (and its calendar event) accordingly.
#   1. Create an application + bot at https://discord.com/developers/applications
#   2. Bot tab -> Reset Token -> DISCORD_BOT_TOKEN below. No privileged
#      intents need enabling (this bot only reads reactions, not presence,
#      server members, or message content).
#   3. OAuth2 -> URL Generator -> scope "bot", permissions: View Channel,
#      Send Messages, Embed Links, Add Reactions, Read Message History.
#      Open the generated URL to invite it to your server.
#   4. Enable Developer Mode in Discord (User Settings -> Advanced), then
#      right-click the channel leads should post to -> Copy Channel ID.
DISCORD_BOT_TOKEN=""
DISCORD_LEADS_CHANNEL_ID=""

# Google Cloud service account, shared by Cloud Storage (src/server/storage.ts)
# and Google Calendar (src/server/google-calendar.ts) — the full JSON key
# content as a single-line string.
GCP_SERVICE_ACCOUNT_KEY=""
GOOGLE_CLOUD_PROJECT=""

# Google Calendar for new leads. Needs the Calendar API enabled on the GCP
# project above, and the target calendar shared with the service account's
# `client_email` (from the JSON key above) with "Make changes to events"
# permission. GOOGLE_CALENDAR_ID is that calendar's id from Calendar Settings
# -> Integrate calendar (looks like an email address, or ends in
# @group.calendar.google.com).
GOOGLE_CALENDAR_ID=""

# Publicly exposed variables (prefixed with NEXT_PUBLIC_)
# Google Analytics 4 ID
NEXT_PUBLIC_GA_ID=""
# The public base URL of the application (e.g., http://localhost:3000)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# SEO and site metadata
# The public URL of the site
SITE_URL="https://muuttokone.fi"
# Google Search Console verification key
GOOGLE_SITE_VERIFICATION=""

# OpenAI API Key for the AI chat feature
GOOGLE_GENERATIVE_AI_API_KEY=""
