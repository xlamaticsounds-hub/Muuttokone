// prisma/schema.prisma

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

/**
 * ===== Enums =====
 */

enum LeadStatus {
  NEW
  QUALIFIED
  CONTACTED
  SCHEDULED
  PROPOSAL_SENT
  WON // = vahvistettu (Discordin ✅ vahvistaa myös kalenterimerkinnän)
  LOST
  ARCHIVED
  COMPLETED // Toteutunut — muutto tehty; completedAt + finalPrice asetetaan samalla
  CANCELLED // Peruttu vahvistuksen jälkeen (LOST = ei koskaan vahvistunut)
}

enum LeadSource {
  QUICK_QUOTE
  STEP_FORM
  WEBSITE
  PHONE
  EMAIL
  REFERRAL
  ADS
  OTHER
}

enum InvoiceStatus {
  DRAFT
  SENT
  UNPAID
  PAID
  OVERDUE
  SUPERSEDED // Korvattu lähetetyllä maksumuistutuksella — ei enää maksettavana
}

enum PartnerReportStatus {
  DRAFT // luotu ja esikatselu lähetetty meille — ei vielä kumppanille
  SENT // hyväksytty hallinnassa ja lähetetty kumppanille
}

/**
 * ===== Core =====
 */

model Contact {
  id          String  @id @default(cuid())
  // Person/company
  firstName   String?
  lastName    String?
  companyName String?
  email       String? // keep non-unique to allow multiple leads per same email (adjust to @unique if you prefer upsert-only)
  phone       String?
  notes       String?

  // Address (flat for easy forms)
  street     String?
  postalCode String?
  city       String?
  region     String?
  country    String? @default("FI")

  // Consent
  gdprConsentAt DateTime?

  // Tags
  tags String[]

  // Audit
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  leads    Lead[]
  invoices Invoice[]
}

model Lead {
  id        String  @id @default(cuid())
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Restrict)
  contactId String

  status LeadStatus @default(NEW)
  source LeadSource @default(WEBSITE)

  // Move details
  formData      Json?
  requestedDate DateTime?
  fromAddress   String?
  toAddress     String?
  volumeM3      Float?
  notes         String?
  
  // New structured fields
  floor         Int?
  hasElevator   Boolean?
  squareMeters  Float?
  boxCount      Int?

  // Discord-botin liidiviestin tunnisteet — reaktioiden (🔵/✅/❌) yhdistämiseen
  // takaisin tähän liidiin. Katso src/server/discord-bot.ts.
  discordMessageId String?
  discordChannelId String?

  // Google Calendar -tapahtuman tunniste, jos keikalle on luotu (alustava)
  // kalenterimerkintä. Katso src/server/google-calendar.ts.
  calendarEventId String?

  // AI:n luoma yhteenveto tarjous@muuttokone.fi-postilaatikon ja asiakkaan välisestä
  // sähköpostikeskustelusta: { summary, agreedDates, openQuestions, messageCount, generatedAt }.
  // Katso src/server/email-summary.ts. Päivittyy joko liidin sivun napista tai
  // ajastetusta /api/cron/email-summaries-reitistä.
  emailSummary Json?

  // Kumppanin alennuskoodi (esim. Kiinteistömaailma). discountCode on käytetty koodi tekstinä,
  // prosentit tallennetaan varaushetken arvoina, jottei koodin myöhempi muokkaus muuta jo
  // tehtyjä kauppoja. Hinnat € sis. alv, laskettu palvelimella (src/features/calculator/discount.ts).
  discountCodeId      String?
  discount            DiscountCode? @relation(fields: [discountCodeId], references: [id], onDelete: SetNull)
  discountCode        String?
  discountPartner     String? // kumppani varaushetkellä — kuukausiraportti valitsee tämän mukaan
  discountOffice      String?
  discountAgentName   String?
  discountPercent     Float?
  commissionPercent   Float?
  priceBeforeDiscount Float?
  discountAmount      Float?
  priceAfterDiscount  Float?

  // Toteutunut muutto (status COMPLETED): milloin merkitty ja lopullinen laskutettu hinta
  // (€ sis. alv, voi poiketa arviosta). Kumppanin välityspalkkio lasketaan finalPrice:sta.
  // Säilyvät historiana jos toteutuminen kumotaan, mutta niitä käytetään vain tilassa COMPLETED.
  completedAt DateTime?
  finalPrice  Float?
  // Milloin muutto lähti kumppanille hyväksytyssä kuukausiraportissa (palkkio laskutettu).
  // Jos toteutuminen kumotaan ja merkitään uudelleen, alkuperäinen completedAt säilyy, ettei
  // muutto päädy myöhemmän kuun raporttiin ja palkkio maksettaisi kahdesti.
  partnerReportedAt DateTime?
  partnerReportId   String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // ✅ indexes
  @@index([contactId])
  @@index([status])
  @@index([source])
  @@index([discountCodeId])
  @@index([completedAt])
}

/// Kumppanien alennuskoodit. Uudet koodit (myös toimipaikka- ja välittäjäkohtaiset) lisätään
/// hallintapaneelista ilman koodimuutoksia.
model DiscountCode {
  id                String    @id @default(cuid())
  code              String    @unique // aina normalizeDiscountCode()-muodossa (isot kirjaimet)
  partner           String // esim. "Kiinteistömaailma"
  office            String? // toimipaikka, esim. "Mankkaa"
  agentName         String? // välittäjän nimi
  discountPercent   Float     @default(10)
  commissionPercent Float     @default(5) // kumppanille maksettava välityspalkkio, % alv 0 -hinnasta
  active            Boolean   @default(true)
  validFrom         DateTime?
  validUntil        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  leads Lead[]
}

/// Kumppanin kuukausiraportin vastaanottajat, muokattavissa hallinnasta (/hallinta/raportit).
/// partner = DiscountCode.partner (esim. "Kiinteistömaailma").
model PartnerSettings {
  id            String   @id @default(cuid())
  partner       String   @unique
  reportEmail   String? // kumppanin osoite, johon hyväksytty raportti lähetetään
  reportCcEmail String? // meidän osoite: esikatselu + kopio lähetetystä raportista
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// Kumppanin kuukausiraportti (välityspalkkio toteutuneista muutoista). data on rivien
/// tilannekuva luontihetkellä: hyväksyntä lähettää täsmälleen esikatsellun version.
/// Ks. src/lib/partner-report.ts ja src/server/partner-reports.ts.
model PartnerReport {
  id            String              @id @default(cuid())
  partner       String
  periodYear    Int
  periodMonth   Int // 1–12, kalenterikuukausi Suomen aikaa
  status        PartnerReportStatus @default(DRAFT)
  data          Json
  previewSentAt DateTime?
  previewSentTo String?
  sentAt        DateTime?
  sentTo        String?
  sentCc        String?
  approvedBy    String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([partner, periodYear, periodMonth])
}

model Invoice {
  id            String  @id @default(cuid())
  invoiceNumber Int     @default(autoincrement())

  contactId    String?
  contact      Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  customerName String // valitun kontaktin nimi, tai käsin kirjoitettu jos asiakasta ei löydy listalta

  status InvoiceStatus @default(DRAFT)

  items   Json // Array<{ description: string; amount: number; vatRate: number }> — amount sis. alv per rivi
  dueDate DateTime?
  sentAt  DateTime?

  // Ostajan osoite ja sähköposti laskulla — käsin kirjoitettu/muokattava kuten customerName,
  // ei riipu siitä onko kontaktia valittu tai onko kontaktin omat tiedot ajan tasalla.
  customerStreet     String?
  customerPostalCode String?
  customerCity       String?
  customerEmail      String?

  // Palvelun suorituspäivä, jos se poikkeaa laskun päiväyksestä (createdAt) — näytetään
  // laskulla vain kun eri kuin createdAt.
  serviceDate DateTime?

  // Sähköpostiosoite johon lasku lähetettiin/lähetetään — valittavissa/kirjoitettavissa
  // laskun sivulla lähetyshetkellä, ei aina sama kuin kontaktin oletusosoite.
  recipientEmail String?

  // Maksumuistutuksella (viivästyskorkolasku): lasku jonka pohjalta muistutus tehtiin.
  // Kun muistutus lähetetään, alkuperäinen merkitään tilaan SUPERSEDED.
  sourceInvoiceId String?
  sourceInvoice   Invoice?  @relation("InvoiceReminders", fields: [sourceInvoiceId], references: [id], onDelete: SetNull)
  reminders       Invoice[] @relation("InvoiceReminders")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contactId])
}

model Log {
  id         String  @id @default(cuid())
  // polymorphic pointer
  entityType String // "Lead" | "Contact" | "Customer" | "Project" | "Task"
  entityId   String
  action     String // "lead.create", "lead.update", "project.schedule", etc.
  message    String?
  data       Json?
  ip         String?

  actorId   String? // User.id if available
  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

/**
 * ===== Blog =====
 */

model Post {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  excerpt         String?
  content         String?   @db.Text
  published       Boolean   @default(false)
  featuredImage   String?
  
  // SEO
  metaTitle       String?
  metaDescription String?
  
  // Basic author info (since no User model is in DB yet)
  authorName      String?   @default("Muuttokone-tiimi")

  // Relations
  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id])
  tags            Tag[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  publishedAt     DateTime?

  @@index([slug])
}

model Category {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  posts Post[]
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  posts Post[]
}

model PageContent {
  id        String   @id @default(cuid())
  slug      String   @unique // e.g., "home", "palvelut"
  title     String
  metadata  Json?    // For page-specific SEO
  sections  Json     // The "Lego" blocks: Array of { id, type, props: { text, images, etc } }
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

model Image {
  id        String   @id @default(cuid())
  url       String   @unique // Public GCS URL
  name      String   // Original filename
  bucket    String   // GCS bucket name
  path      String   // Path within bucket
  type      String   // mime type
  size      Int      // bytes
  alt       String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([url])
}